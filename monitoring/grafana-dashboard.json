{
  "title": "Digital Library",
  "uid": "digital-library",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(http_requests_total[1m])", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total requests",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [{ "expr": "http_requests_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Server up (1 = yes)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [{ "expr": "up{job=\"digital-library\"}", "refId": "A" }]
    }
  ]
}